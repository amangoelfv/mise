# Committed on purpose: PUBLIC build-time values only (they end up in the browser bundle).
# Never put secrets here; those go in Secret Manager (see DEPLOY.md).

# Google OAuth client ID (Web application, project okan-creators). Public by design.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=381604248306-asdg0plj160sgfndffdmc9ojqpjqtjat.apps.googleusercontent.com

# Public URL: canonical links, share-image URLs, sitemap, and OAuth/logout redirects.
# Needed at build time too (pre-rendered pages). A Cloud Run env var with the same name overrides it.
APP_URL=https://mise-381604248306.asia-south1.run.app

# Keep "Continue with demo account" available for judges.
NEXT_PUBLIC_DEMO_LOGIN=1
