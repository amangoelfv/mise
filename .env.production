# Committed on purpose: PUBLIC build-time values only (they end up in the browser bundle).
# Never put secrets here; those go in Secret Manager (see DEPLOY.md).

# Google OAuth client ID (Web application). Leave commented to ship demo login only.
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=1234567890-abc.apps.googleusercontent.com

# Keep "Continue with demo account" available for judges.
NEXT_PUBLIC_DEMO_LOGIN=1
