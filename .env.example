# Copy to .env.local. Every variable is optional for local dev:
# without them Mise uses its built-in dish menu, a demo login and a simulated cart service.

# Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# ...or, on Google Cloud, use Vertex AI with the service account instead of a key:
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=your-project
# GOOGLE_CLOUD_LOCATION=global
# GEMINI_MODEL=gemini-3.8-flash          # ingredient lists
# GEMINI_FAST_MODEL=gemini-3.5-flash-lite # the four style cards

# Google sign-in (OAuth client of type "Web application"; add your origins as
# Authorized JavaScript origins, e.g. http://localhost:3200)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# Show "Continue with demo account" even when Google sign-in is configured (for judges)
# NEXT_PUBLIC_DEMO_LOGIN=1

# 32+ random characters; signs the session cookie and encrypts store tokens.
# Generate with: openssl rand -base64 48
SESSION_SECRET=

# Public URL in production (used for the Zepto OAuth redirect), e.g. https://mise.example.com
# APP_URL=

# Zepto MCP OAuth. Leave empty to use dynamic client registration.
# ZEPTO_CLIENT_ID=
#
# Single-account env override for hosted/demo use (one shared Zepto account; no
# interactive sign-in). The access token lives ~1h, so Mise reads its real expiry
# from the token and AUTO-REFRESHES it. For refresh to work you MUST also set the
# refresh token AND the client id it was issued to. Get all three from the admin
# connect flow: open /admin (ADMIN_ENABLED=1), connect, then copy them from
# /api/connectors/zepto/token (ZEPTO_TOKEN_EXPORT=1). Restart dev after editing env.
# ZEPTO_ACCESS_TOKEN=
# ZEPTO_REFRESH_TOKEN=
# ZEPTO_CLIENT_ID=                 # REQUIRED for auto-refresh (the DCR client id)
# ZEPTO_ACCESS_TOKEN_EXPIRES_AT=   # optional; the token's own exp is used when present
# ZEPTO_DEMO_ACCESS_TOKEN=
# ZEPTO_DEMO_REFRESH_TOKEN=
# ZEPTO_DEMO_CLIENT_ID=            # REQUIRED for auto-refresh
# ZEPTO_DEMO_ACCESS_TOKEN_EXPIRES_AT=

# Your teammate's cart service (see CONTRACT.md). Empty = simulated locally.
# CART_API_URL=https://cart.example.com
# CART_API_KEY=
